#!/usr/bin/env bash
# Install a decrypted iOS .ipa as a Mac app: converted to Mac Catalyst,
# re-signed ad-hoc, sandboxed, moved into /Applications. No PlayCover.
#
# The sections below are the install, in order, and each says why it is there.
# README.md has the whole picture; what a reader needs here is the shape:
#
#   1. unpack the ipa and read its Info.plist
#   2. neutralise a bundled keychain-fix tweak, which would steal the calls
#      the keychain shim exists for
#   3. refuse FairPlay-encrypted binaries, before anything has changed
#   4. convert every Mach-O: arm64, Mac Catalyst, the system Swift overlay
#   5. rendering: the shipped idiom, or the Mac idiom on request
#   6. link in what the app needs -- PlayTools (--playtools), the keychain
#      shim, the OpenGL ES redirect, --dylib libraries
#   7. sign every Mach-O, then every nested bundle, then the app itself
#   8. write PlayTools' settings, then move the bundle into place
#
# --configure does none of that: it rewrites PlayTools' settings and keymap
# for an app that is already installed, and stops.
#
# What it needs: a DECRYPTED ipa (an App Store copy is FairPlay-encrypted and
# refused at step 3; decrypting needs a jailbroken device or an
# already-decrypted source, and nothing here does it), and Xcode's command
# line tools -- lipo, otool, vtool, install_name_tool, file, and clang with
# the macOS SDK for the libraries this builds. --playtools additionally needs
# full Xcode with the iOS SDK and git, for its one-time build from source.
#
# The installed bundle is user-owned; remove it by dragging it to the Trash.

set -Eeuo pipefail
# Under set -e a failing pipeline exits with no message; say where. -E so the
# trap also fires for a failure inside a function (convert_macho, cryptid_of,
# resolve_path) rather than only at the top level -- without it bash does not
# inherit ERR into functions at all.
trap 'echo "ipa-install-on-mac: failed at line $LINENO: $BASH_COMMAND" >&2' ERR

USAGE_TEXT='Usage: ipa-install-on-mac <file.ipa> [options]
       ipa-install-on-mac --configure <App.app | bundle id> [PlayTools options] [--open]

Install options:
  --dest DIR        install into DIR instead of /Applications
  --open            launch it afterwards and confirm the process appeared
  --force           replace a same-named bundle even if its bundle id differs
  --keep            keep the work directory for inspection
  --mac-idiom       render in the Mac idiom (1:1 with the display) instead of
                    the shipped iPad/iPhone layout; see README before using it
  --scaled          the shipped idiom (the default; kept for old invocations)
  --no-keychain     no emulated keychain: logins will not survive a relaunch
  --reset           clear the app'"'"'s sandbox container and emulated keychain first
  --playtools       embed PlayTools (keyboard/mouse mapping, resolution control);
                    implied by every option below
  --dylib FILE      also link FILE into the app: a .c/.m source (built for Mac
                    Catalyst against the macOS SDK) or a .dylib; repeatable

PlayTools options (install, or --configure an installed app):
  --resolution R    auto | 1080p | 1440p | 4k | WIDTHxHEIGHT | resizable | app-default
  --aspect A        4:3 | 16:9 | 16:10 (1080p/1440p/4k), or free (resizable)
  --map KEY=X,Y[,S]       KEY taps the screen at X,Y (fractions of the window,
                          0,0 top left); S = size, % of the longer side
  --drag KEY=X,Y[,S]      KEY holds a touch at X,Y and the mouse drags it
  --joystick KEYS=X,Y[,S] wasd | arrows | UP/LEFT/DOWN/RIGHT drive a stick at X,Y
  --mouse-look X,Y[,S]    the mouse moves a touch in this area (camera)
  --keymap FILE     start the keymap from a PlayCover keymap (.playmap / .plist)
  --set KEY=VALUE   any other PlayTools setting, e.g. iosDeviceModel=iPad13,8,
                    hideTitleBar=true, customScaler=1.5, sensitivity=70
  Any --map/--drag/--joystick/--mouse-look/--keymap replaces the default keymap;
  without them the existing one (e.g. made with Cmd+K in the app) is kept.'
# Two exits for the same text: a bad invocation (missing/unknown argument, no
# ipa given) is a usage ERROR -- stderr, exit 1, the shell convention -- while
# an explicit -h/--help asked for exactly this text and gets it on stdout with
# exit 0, so `ipa-install-on-mac --help` is script- and pipe-friendly (`... |
# head`, `... && echo ok`) rather than always tripping `set -e` in a caller.
usage() { echo "$USAGE_TEXT" >&2; exit 1; }
help()  { echo "$USAGE_TEXT"; exit 0; }
die()  { echo "ipa-install-on-mac: $*" >&2; exit 2; }
# ~ for $HOME in messages; ${var/#$HOME/\~} prints a literal \~ on bash 3.2.
tilde() { case "$1" in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }
warn() { echo "ipa-install-on-mac: warning: $*" >&2; }
# A captured stderr file on one line, so a tool's multi-line complaint still
# reads as one message.
oneline() { tr '\n' ' ' < "$1"; }
# One Info.plist value, empty when it is not there: a key this asks for is
# usually optional, and an ipa is untrusted input.
plist_get() { plutil -extract "$2" raw -o - "$1" 2>/dev/null || true; }
# Absolute, without resolving symlinks: --dylib names the library it builds
# after this file, so following a link here would rename it.
abs_path() { printf '%s/%s\n' "$(cd "$(dirname "$1")" && pwd)" "$(basename "$1")"; }
# Reverse-DNS, and nothing else: a bundle id becomes a path below (the
# --reset container wipe, PlayTools' settings), and an ipa is untrusted
# input, so "../../Documents" must be refused before it is interpolated.
check_bundle_id() {
  case "$1" in
    ""|*/*|*..*|*[!A-Za-z0-9._-]*) die "implausible bundle id: $1" ;;
  esac
}
# Is exactly this executable running? ps -o comm= prints the full path.
running_exe() { ps -axo comm= | grep -Fx "$1" >/dev/null; }
# The macOS SDK, resolved once and kept: every dylib this tool builds is
# compiled against it. $1 says what to do about it, which depends on why it
# was needed (the keychain shim can be skipped, the OpenGL ES one cannot).
need_sdk() {
  [ -n "${SDK:-}" ] || SDK=$(xcrun --sdk macosx --show-sdk-path 2>/dev/null) \
    || die "no macOS SDK (xcrun --sdk macosx); $1"
}
# Version order, for the two versions that are compared here (each binary's
# SDK, and MinimumOSVersion); sort -V, because 14.10 is above 14.9.
lowest_version()  { printf '%s\n' "$@" | sort -V | head -1; }
highest_version() { printf '%s\n' "$@" | sort -V | tail -1; }

IPA=""; DEST="/Applications"; OPEN=0; FORCE=0; KEEP=0; SCALED=0; KEYCHAIN=1; RESET=0
PLAYTOOLS=0; MAC_IDIOM=0; CONFIGURE=""
INSTALL_ONLY=""   # the last flag that only makes sense for an install, to name in the error
PT_ARGS=()   # handed to lib/playtools-config.py as given
DYLIBS=()    # --dylib files, absolute paths
while [ $# -gt 0 ]; do
  case "$1" in
    --dest)  [ $# -ge 2 ] || usage; DEST="$2"; INSTALL_ONLY="$1"; shift 2 ;;
    --open)  OPEN=1; shift ;;
    --force) FORCE=1; INSTALL_ONLY="$1"; shift ;;
    --keep)  KEEP=1; INSTALL_ONLY="$1"; shift ;;
    --scaled)      SCALED=1; INSTALL_ONLY="$1"; shift ;;
    --no-keychain) KEYCHAIN=0; INSTALL_ONLY="$1"; shift ;;
    --reset)       RESET=1; INSTALL_ONLY="$1"; shift ;;
    --playtools)   PLAYTOOLS=1; INSTALL_ONLY="$1"; shift ;;
    --mac-idiom)   MAC_IDIOM=1; INSTALL_ONLY="$1"; shift ;;
    --configure)   [ $# -ge 2 ] || usage; CONFIGURE="$2"; shift 2 ;;
    --dylib)
      [ $# -ge 2 ] || usage
      [ -f "$2" ] || die "--dylib: no such file: $2"
      case "$2" in *.c|*.m|*.dylib) ;; *) die "--dylib takes a .c, .m or .dylib file: $2" ;; esac
      DYLIBS+=("$(abs_path "$2")"); INSTALL_ONLY="$1"; shift 2 ;;
    --resolution|--aspect|--map|--drag|--joystick|--mouse-look|--set)
      [ $# -ge 2 ] || usage; PT_ARGS+=("$1" "$2"); PLAYTOOLS=1; shift 2 ;;
    --keymap)
      [ $# -ge 2 ] || usage
      [ -f "$2" ] || die "--keymap: no such file: $2"
      PT_ARGS+=("$1" "$(abs_path "$2")"); PLAYTOOLS=1; shift 2 ;;
    -h|--help) help ;;
    -*) usage ;;
    *) [ -z "$IPA" ] || usage; IPA="$1"; shift ;;
  esac
done
# --configure and an install are two different commands sharing one parser.
if [ -n "$CONFIGURE" ]; then
  [ -z "$IPA" ] || die "--configure changes an installed app; it takes no ipa"
  [ -z "$INSTALL_ONLY" ] || die "$INSTALL_ONLY applies to an install, not to --configure"
else
  [ -n "$IPA" ] || usage
  [ -f "$IPA" ] || die "no such file: $IPA"
fi
[ "$MAC_IDIOM" -eq 0 ] || [ "$SCALED" -eq 0 ] || die "--mac-idiom and --scaled contradict each other"
# The shim and PlayTools both interpose SecItemAdd/CopyMatching/Update/Delete,
# and PlayTools does so unconditionally (it forwards to the real keychain when
# its PlayChain is off), so exactly one of them is the keychain.
USE_SHIM=0; USE_PLAYCHAIN=0
if [ "$KEYCHAIN" -eq 1 ]; then
  if [ "$PLAYTOOLS" -eq 1 ]; then USE_PLAYCHAIN=1; else USE_SHIM=1; fi
fi
# Where PlayTools reads its settings, keymaps and PlayChain: it builds the
# path from /Users/<login> itself (upstream reverted a portable lookup on
# 2026-09-12), so this does too.
PLAYCOVER_DIR="/Users/$(id -un)/Library/Containers/io.playcover.PlayCover"

# ── Tools ───────────────────────────────────────────────────────────────────
# The shim's source, the load-command editor and the PlayTools helpers live in
# ../lib relative to this script's REAL location (not $0 as typed), so a
# symlink into ~/.local/bin (see install.sh) still finds them: resolve every
# level of symlink by hand rather than relying on `readlink -f`, which is a
# GNU extension and not the BSD readlink macOS ships.
resolve_path() {
  local target="$1" link dir
  while [ -L "$target" ]; do
    link="$(readlink "$target")"
    case "$link" in
      /*) target="$link" ;;
      *)  target="$(dirname "$target")/$link" ;;
    esac
  done
  dir="$(cd "$(dirname "$target")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$target")"
}
SELF="$(resolve_path "$0")"
# 2>/dev/null + || true: a cd failure (../lib does not exist at all) must
# fall through to the die() below with its hint, not abort here with a raw
# "no such file or directory".
LIB_DIR="$(cd "$(dirname "$SELF")/../lib" 2>/dev/null && pwd || true)"
need_lib() {
  local f
  for f in "$@"; do
    [ -n "$LIB_DIR" ] && [ -f "$LIB_DIR/$f" ] || die "lib/$f not found next to $SELF"
  done
}
if [ -z "$CONFIGURE" ] || [ "$PLAYTOOLS" -eq 1 ]; then
  command -v python3 >/dev/null 2>&1 || die "missing python3 (Xcode's Command Line Tools provide it)"
fi
if [ "$PLAYTOOLS" -eq 1 ] || [ -n "$CONFIGURE" ]; then
  need_lib playtools-config.py
  # Refuse a malformed --map/--resolution/... before minutes of work, not after.
  python3 "$LIB_DIR/playtools-config.py" --check ${PT_ARGS[@]+"${PT_ARGS[@]}"} || exit 1
fi

# ── --configure: settings and keymap only, for an app already installed ────
# Where an installed app with this bundle id is, if it is anywhere this can
# see: only the two directories a user installs into. Empty is not an error --
# the settings are PlayCover's, not the bundle's, and can be written before
# the app exists.
installed_app_with_id() {
  local dir app
  for dir in /Applications "$HOME/Applications"; do
    for app in "$dir"/*.app; do
      [ -f "$app/Info.plist" ] || continue
      if [ "$(plist_get "$app/Info.plist" CFBundleIdentifier)" = "$1" ]; then
        printf '%s\n' "$app"
        return 0
      fi
    done
  done
  return 0
}

configure_installed_app() {
  local app_path="" bid="" exe running=0
  if [ -d "$CONFIGURE" ]; then
    app_path="$(cd "$CONFIGURE" && pwd)"
    bid=$(plist_get "$app_path/Info.plist" CFBundleIdentifier)
    [ -n "$bid" ] || die "$CONFIGURE has no Info.plist with a CFBundleIdentifier"
  else
    bid="$CONFIGURE"
    app_path=$(installed_app_with_id "$bid")
  fi
  check_bundle_id "$bid"
  [ -n "$app_path" ] || warn "no installed app with bundle id $bid in /Applications or ~/Applications; writing its settings anyway -- check the id"
  if [ -n "$app_path" ]; then
    exe=$(plist_get "$app_path/Info.plist" CFBundleExecutable)
    if ! otool -L "$app_path/$exe" 2>/dev/null | grep -F 'PlayTools.framework/PlayTools' >/dev/null; then
      warn "$app_path has no PlayTools linked (installed without --playtools?); these settings apply once it is reinstalled with --playtools"
    fi
    running_exe "$app_path/$exe" && running=1
  fi
  echo "PlayTools settings for $bid${app_path:+ ($app_path)}:"
  python3 "$LIB_DIR/playtools-config.py" --bundle-id "$bid" ${PT_ARGS[@]+"${PT_ARGS[@]}"} | sed 's/^/  /'
  # PlayTools reads both files once, at launch, so a running app is told.
  if [ "$running" -eq 1 ]; then
    echo "It is running: quit it (Cmd+Q) and open it again for these to apply; PlayTools reads them at launch."
  elif [ "$OPEN" -eq 1 ] && [ -n "$app_path" ]; then
    open "$app_path" && echo "Launched $app_path"
  fi
}
if [ -n "$CONFIGURE" ]; then
  configure_installed_app
  exit 0
fi

for t in unzip plutil codesign xattr file; do
  command -v "$t" >/dev/null 2>&1 || die "missing $t"
done
for t in lipo otool vtool install_name_tool; do
  xcrun -f "$t" >/dev/null 2>&1 || die "missing $t: install Xcode or the Command Line Tools (xcode-select --install)"
done
LIPO=$(xcrun -f lipo); OTOOL=$(xcrun -f otool); VTOOL=$(xcrun -f vtool)
INSTALL_NAME_TOOL=$(xcrun -f install_name_tool)
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
if [ "$USE_SHIM" -eq 1 ] || [ "$USE_PLAYCHAIN" -eq 1 ] || [ "$PLAYTOOLS" -eq 1 ]; then
  SDK=$(xcrun --sdk macosx --show-sdk-path 2>/dev/null) || die "no macOS SDK (xcrun --sdk macosx); install Xcode or pass --no-keychain"
fi
[ "$USE_SHIM" -eq 0 ] || need_lib ipa-keychain.c ipa-inject-dylib.py
[ ${#DYLIBS[@]} -eq 0 ] || need_lib ipa-inject-dylib.py
[ "$PLAYTOOLS" -eq 0 ] || need_lib ipa-inject-dylib.py playtools-build.sh playtools/Package.resolved

# ── Unpack ──────────────────────────────────────────────────────────────────
# The work dir is under TMPDIR, the same APFS volume as /Applications, so the
# final move is a rename: a reader never sees a half-copied bundle.
WORK=$(mktemp -d "${TMPDIR:-/tmp}/ipa-install-on-mac.XXXXXX")
cleanup() { if [ "$KEEP" -eq 1 ]; then echo "work dir kept: $WORK"; else rm -rf "$WORK"; fi; }
trap cleanup EXIT

# grep without -q: under pipefail an early exit would SIGPIPE the producer.
unzip -l "$IPA" 2>/dev/null | grep 'Payload/[^/]*\.app/Info\.plist' >/dev/null \
  || die "not an ipa (no Payload/<App>.app/Info.plist inside): $IPA"
echo "Unpacking $(basename "$IPA") ..."
unzip -q "$IPA" -d "$WORK/x" || die "unzip failed"

APP=""
n=0
for d in "$WORK"/x/Payload/*.app; do
  [ -d "$d" ] || continue
  APP="$d"; n=$((n + 1))
done
[ "$n" -eq 1 ] || die "expected exactly one .app under Payload/, found $n"

PLIST="$APP/Info.plist"
[ -f "$PLIST" ] || die "no Info.plist in $(basename "$APP")"
EXE=$(plist_get "$PLIST" CFBundleExecutable); [ -n "$EXE" ] || die "Info.plist has no CFBundleExecutable"
BID=$(plist_get "$PLIST" CFBundleIdentifier); [ -n "$BID" ] || die "Info.plist has no CFBundleIdentifier"
# Both become paths below, before anything has been checked for sanity: the
# id in the --reset container wipe and in every install's container note, the
# executable's name in a chmod and in the load commands injected into it.
check_bundle_id "$BID"
case "$EXE" in
  */*|.|..) die "implausible executable name: $EXE" ;;
esac
NAME=$(plist_get "$PLIST" CFBundleDisplayName)
[ -n "$NAME" ] || NAME=$(plist_get "$PLIST" CFBundleName)
[ -n "$NAME" ] || NAME="$EXE"
NAME=$(printf '%s' "$NAME" | tr '/:' '__')   # the installed bundle is named after it
MIN_OS=$(plist_get "$PLIST" MinimumOSVersion)
[ -f "$APP/$EXE" ] || die "executable $EXE not found in the bundle"
echo "  $NAME ($BID), executable $EXE, iOS ${MIN_OS:-?}+"

# --reset must refuse before ANYTHING else happens, not just before the
# container is cleared: the previous copy at $DEST/$NAME.app is moved to
# ~/.Trash further down (in the Install section, well before this script
# would otherwise reach the container wipe), and finding out only there that
# the app is still running would leave that copy trashed with nothing yet
# built to replace it.
if [ "$RESET" -eq 1 ] && ps -axo comm= | grep -F "/$NAME.app/" >/dev/null; then
  die "--reset needs the app quit first: a running $NAME would write its state straight back"
fi

# ── Building and linking what the app needs ────────────────────────────────
# Everything this tool adds to an app is a dylib built for Mac Catalyst
# against the macOS SDK -- the same target the bundle's own binaries are
# converted to -- and linked into the main executable, because an interposing
# library only works when it is loaded at launch.
#   $1 the file to write, $2 the install name, $3 the source, $4 what to say
#   if clang fails, and then any flags this particular library needs.
catalyst_dylib() {
  local out="$1" install_name="$2" src="$3" what="$4"
  shift 4
  xcrun clang -target arm64-apple-ios14.0-macabi -isysroot "$SDK" ${1+"$@"} -dynamiclib \
    -install_name "$install_name" -o "$out" "$src" 2>"$WORK/clang.err" \
    || die "$what: $(oneline "$WORK/clang.err")"
}
# Add the load command, and have the file signed with the rest of the bundle
# ($MACHOS is what the signing loop reads).
#   $1 the file, $2 the install name the app loads it by, $3 what to call it.
link_into_app() {
  python3 "$LIB_DIR/ipa-inject-dylib.py" "$APP/$EXE" "$2" >/dev/null 2>"$WORK/inject.err" \
    || die "could not link $3 into $EXE: $(oneline "$WORK/inject.err")"
  printf '%s\n' "$1" >> "$MACHOS"
}

# ── Keychain-fix tweaks: neutralised, the shim is the keychain now ──────────
# See README.md's "Measured traps": a sideloading tweak that hooks
# SecItemAdd steals the calls the shim exists for (measured 2026-09-06 on a
# tweaked app carrying a `[sideloadKeychainFix].dylib`). PlayChain sits in the
# same place, so the same tweaks are emptied under --playtools.
# Its load command is not removed -- that would shift the two-level namespace
# ordinal of every later dylib -- so the FILE is replaced by an empty dylib
# of the same install name: dyld still finds it, nothing runs.
NEUTRALISED=""
if [ "$USE_SHIM" -eq 1 ] || [ "$USE_PLAYCHAIN" -eq 1 ]; then
  printf 'void ipa_neutralised(void) {}\n' > "$WORK/noop.c"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    # Keep its install name, whatever it is: that is the name dyld looks up.
    oldid=$("$OTOOL" -D "$f" 2>/dev/null | sed -n '2p')
    [ -n "$oldid" ] || continue
    catalyst_dylib "$f" "$oldid" "$WORK/noop.c" "could not neutralise ${f#"$APP"/}"
    NEUTRALISED="$NEUTRALISED ${f#"$APP"/}"
  done < <(find "$APP" -type f -iname '*.dylib' | grep -iE 'keychain.?fix|sideload.?keychain' || true)
  [ -z "$NEUTRALISED" ] || echo "  neutralised keychain-fix tweak(s):$NEUTRALISED"
fi

# ── Every Mach-O in the bundle ──────────────────────────────────────────────
# Frameworks, dylibs and extensions must be converted too: dyld refuses to load
# an iOS-platform image into a Catalyst process.
# `file` exits non-zero on an odd file and xargs then returns 123, which under
# pipefail aborted the script with no message on a real app (a ~4000-file
# tweaked app). Capture first, tolerate the status, filter second.
# The C locale throughout: `file` describes data files from their bytes, and
# macOS awk in a UTF-8 locale aborts on the first invalid sequence ("towc:
# multibyte conversion failure", measured 2026-09-16 on Google Photos 7.92,
# a resource `file` took for a matrix with a garbage byte in its header).
MACHOS="$WORK/machos"
{ find "$APP" -type f -print0 | LC_ALL=C xargs -0 file --no-dereference -F "$(printf '\t')"; } > "$WORK/file.out" 2>/dev/null || true
# A fat binary gets extra lines "path (for architecture X):" after its own;
# drop those or lipo is handed a name that does not exist.
LC_ALL=C awk -F '\t' '$2 ~ /Mach-O/ && $1 !~ / \(for architecture [^)]*\):?$/ { print $1 }' "$WORK/file.out" | LC_ALL=C sort -u > "$MACHOS"
[ -s "$MACHOS" ] || die "no Mach-O binaries found in the bundle"

# ── Refuse FairPlay-encrypted binaries before changing anything ─────────────
cryptid_of() {  # first cryptid in the file's LC_ENCRYPTION_INFO(_64), or empty
  # awk reads to the end on purpose: exiting at the first hit SIGPIPEs otool
  # on a binary with many load commands, and pipefail then fails the pipeline.
  "$OTOOL" -l "$1" 2>/dev/null | awk '/LC_ENCRYPTION_INFO/ { f = 1 } f && /cryptid/ && !d { print $2; d = 1 }' || true
}
ENCRYPTED=""
while IFS= read -r f; do
  c=$(cryptid_of "$f")
  if [ -n "$c" ] && [ "$c" != "0" ]; then ENCRYPTED="$ENCRYPTED  ${f#"$APP"/}"$'\n'; fi
done < "$MACHOS"
if [ -n "$ENCRYPTED" ]; then
  printf 'ipa-install-on-mac: %s is FairPlay-encrypted (cryptid 1), still an App Store copy:\n%s' "$NAME" "$ENCRYPTED" >&2
  die "decrypt it first; this tool does not (and cannot) remove FairPlay"
fi

# PlayTools is built once per pinned commit and cached (the first time is
# about a minute and needs the network) -- only now, so an ipa refused above
# never costs a build.
if [ "$PLAYTOOLS" -eq 1 ]; then
  PT_BUILD=$("$LIB_DIR/playtools-build.sh") || die "could not build PlayTools (see above)"
  PT_REV=$("$LIB_DIR/playtools-build.sh" --rev)
fi

# ── Convert: arm64 only, Mac Catalyst platform, system Swift UIKit overlay ──
# Thin a fat binary down to its plain arm64 slice, refusing anything this tool
# has not been exercised on. arm64e (pointer authentication) is a slice of its
# own, and `lipo -thin arm64` on an arm64e-only binary is a no-op that would
# carry an untested arch through vtool and codesign, so it is refused instead.
thin_to_arm64() {
  local f="$1" archs
  archs=$("$LIPO" -archs "$f" 2>/dev/null || true)
  case " $archs " in
    *" arm64 "*) ;;
    *" arm64e "*) die "${f#"$APP"/} has only an arm64e slice (archs: $archs); this tool needs a plain arm64 slice -- ask upstream for one, or --keep and convert it by hand" ;;
    *) die "no arm64 slice in ${f#"$APP"/} (archs: ${archs:-unknown})" ;;
  esac
  if [ "$(printf '%s\n' "$archs" | wc -w)" -gt 1 ]; then
    "$LIPO" -thin arm64 -output "$f.thin" "$f" && mv -f "$f.thin" "$f" || die "lipo -thin failed on ${f#"$APP"/}"
  fi
}

# The SDK version to stamp on a binary: its OWN, never below PlayCover's 14.0.
# UIKit and SwiftUI switch behaviour on the SDK an app was linked against
# ("linked on or after"), and a Catalyst build version counts in iOS versions,
# so PlayCover's fixed 14.0 told a 2026 app it was built for iOS 14: Google
# Photos 7.92 (SDK 26.4) then showed no photo grid, no Videos or Creations,
# and its Recently Added grid laid itself out at zero width forever, the main
# thread pinned in SwiftUI (measured 2026-09-16; with its own 26.4 every one
# of them renders).
sdk_version_of() {
  local sdk
  sdk=$("$OTOOL" -l "$1" 2>/dev/null | awk '/LC_BUILD_VERSION|LC_VERSION_MIN_IPHONEOS/ { c = 1 } c && $1 == "sdk" && !d { print $2; d = 1 }' || true)
  case "$sdk" in
    [0-9]*.[0-9]*) [ "$(lowest_version "$sdk" 14.0)" = "14.0" ] || sdk=14.0 ;;
    *) sdk=14.0 ;;
  esac
  printf '%s\n' "$sdk"
}

# One Mach-O, in place: thinned, its platform rewritten to Mac Catalyst at
# PlayCover's minimum 11.0 (what lets LaunchServices treat the bundle as a
# Catalyst app, which an ad-hoc signature is allowed to launch), and the one
# iOS-specific Swift overlay repointed at the system's copy.
convert_macho() {
  local f="$1" sdk
  thin_to_arm64 "$f"
  sdk=$(sdk_version_of "$f")
  "$VTOOL" -set-build-version maccatalyst 11.0 "$sdk" -replace -output "$f.vt" "$f" >/dev/null 2>"$WORK/vtool.err" \
    && mv -f "$f.vt" "$f" \
    || die "vtool could not rewrite the platform of ${f#"$APP"/}: $(oneline "$WORK/vtool.err")"
  # /usr/lib/swift has no UIKit overlay on macOS; Catalyst's copy lives under
  # /System/iOSSupport. Only this one overlay is iOS-specific.
  if "$OTOOL" -L "$f" 2>/dev/null | grep '@rpath/libswiftUIKit\.dylib' >/dev/null; then
    "$INSTALL_NAME_TOOL" -change @rpath/libswiftUIKit.dylib /System/iOSSupport/usr/lib/swift/libswiftUIKit.dylib "$f" 2>/dev/null \
      || warn "could not repoint libswiftUIKit in ${f#"$APP"/}; the app may fail to launch"
  fi
}
COUNT=0
while IFS= read -r f; do
  convert_macho "$f"
  COUNT=$((COUNT + 1))
done < "$MACHOS"
chmod 755 "$APP/$EXE"
rm -f "$APP/embedded.mobileprovision"

# LaunchServices reads MinimumOSVersion as a system requirement once the
# platform says Catalyst; an iOS 17 app would otherwise "need macOS 17".
if [ -n "$MIN_OS" ] && [ "$(highest_version "$MIN_OS" 11.0)" != "11.0" ]; then
  plutil -replace MinimumOSVersion -string 11.0 "$PLIST" >/dev/null
fi

# ── Rendering: the shipped idiom, or the Mac idiom on request ───────────────
# UIKit decides the idiom from UIDeviceFamily at launch; 6 = Mac. Appended,
# never replaced, so an iPhone-only app keeps its 1, and it only takes effect
# at the next cold launch. PlayTools works in either (measured with the probe:
# its forced resolution and the keymap both still apply in the Mac idiom).
#
# The default is the idiom the app shipped with, as PlayCover does: an iPad
# app runs in the iPad layout, which Catalyst scales to 77% on a Mac.
# --mac-idiom instead runs the process in UIUserInterfaceIdiom.mac, 1:1 with
# the Mac's points (measured 2026-09-06: the reported idiom changes 1 -> 5
# from this one plist edit). That is right for an app that tolerates it
# (YouTube did) and wrong for one that does not: in the Mac idiom UIKit draws
# its controls as native Mac controls and apps skip every code path gated on
# .pad, which on Google Photos 7.92 (2026-09-16) collapsed Collections into
# rows of tiny push buttons and crashed every share sheet (a popover
# presented with no source view). The Mac idiom was the default until then.
if [ "$MAC_IDIOM" -eq 1 ]; then
  fams=$(plutil -extract UIDeviceFamily json -o - "$PLIST" 2>/dev/null || true)
  case "$fams" in
    "")                          plutil -insert UIDeviceFamily -json '[1,2,6]' "$PLIST" >/dev/null ;;
    *[!0-9]6[!0-9]*|*[!0-9]6)    ;;
    *)                           plutil -insert UIDeviceFamily -integer 6 -append "$PLIST" >/dev/null ;;
  esac
  RENDER="Mac idiom, 1:1 with the display (UIDeviceFamily $(plutil -extract UIDeviceFamily json -o - "$PLIST" 2>/dev/null))"
else
  RENDER="shipped idiom (UIDeviceFamily $(plutil -extract UIDeviceFamily json -o - "$PLIST" 2>/dev/null || echo '?'))"
  if [ "$PLAYTOOLS" -eq 1 ]; then RENDER="$RENDER, screen size set by PlayTools"; else RENDER="$RENDER; --mac-idiom renders 1:1 instead"; fi
fi

# ── PlayTools: embedded in the app, linked into the main executable ─────────
# PlayTools is the layer PlayCover injects into a game: keyboard and mouse to
# touch mapping with an in-app editor (Cmd+K), resolution and aspect control,
# device model spoofing, and PlayChain. It is built from upstream source at a
# pinned commit (lib/playtools-build.sh) and its settings and keymaps are
# written where it reads them (lib/playtools-config.py); PlayCover.app is
# neither used nor needed.
#
# PlayCover installs one shared copy in ~/Library/Frameworks and links every
# game to that absolute path; embedding instead pins each app to the build it
# was installed with and never touches the copy a PlayCover.app on the same
# Mac keeps there. PlayTools loads its AppKit half from
# Bundle.main.builtInPlugInsURL (AKPluginLoader.swift), i.e. the APP's
# PlugIns/, which is where AKInterface.bundle goes. AKInterface is a native
# macOS bundle and stays one: signed below, never converted.
if [ "$PLAYTOOLS" -eq 1 ]; then
  PT_FRAMEWORK="$APP/Frameworks/PlayTools.framework"
  AK_BUNDLE="$APP/PlugIns/AKInterface.bundle"
  mkdir -p "$APP/Frameworks" "$APP/PlugIns"
  rm -rf "$PT_FRAMEWORK" "$AK_BUNDLE"
  cp -R "$PT_BUILD" "$PT_FRAMEWORK"
  mv "$PT_FRAMEWORK/PlugIns/AKInterface.bundle" "$AK_BUNDLE"
  rm -rf "$PT_FRAMEWORK/PlugIns" "$PT_FRAMEWORK/Headers" "$PT_FRAMEWORK/Modules"
  # Its toasts look their strings up in Bundle.main (table "Playtools"): into
  # the app's own lproj directories that match, en only when none do -- a new
  # lproj directory makes the whole app claim that localization.
  placed=0
  for l in "$PT_FRAMEWORK"/*.lproj; do
    [ -f "$l/Playtools.strings" ] && [ -d "$APP/${l##*/}" ] || continue
    cp "$l/Playtools.strings" "$APP/${l##*/}/"; placed=1
  done
  if [ "$placed" -eq 0 ] && [ -f "$PT_FRAMEWORK/en.lproj/Playtools.strings" ]; then
    mkdir -p "$APP/en.lproj"; cp "$PT_FRAMEWORK/en.lproj/Playtools.strings" "$APP/en.lproj/"
  fi
  convert_macho "$PT_FRAMEWORK/PlayTools"
  link_into_app "$PT_FRAMEWORK/PlayTools" @executable_path/Frameworks/PlayTools.framework/PlayTools PlayTools
elif [ -d "$APP/Frameworks/UnityFramework.framework" ]; then
  echo "  hint: this looks like a game (UnityFramework); --playtools adds keyboard and mouse mapping"
fi

# ── Keychain: the file-backed shim, linked into the main executable ─────────
# An ad-hoc signature has no application-identifier, so every SecItemAdd in a
# Catalyst app answers -34018 (errSecMissingEntitlement) and no login survives
# a relaunch; claiming keychain-access-groups instead makes AMFI refuse to
# spawn the process at all. So the keychain is replaced rather than fixed:
# lib/ipa-keychain.c (which carries the measurements and the security
# trade-off) interposes the four SecItem calls into a 0600 plist inside the
# app's own sandbox container. Under --playtools this is PlayChain's job
# instead -- PlayTools interposes the same four calls, and two interposers
# cannot share a process.
if [ "$USE_SHIM" -eq 1 ]; then
  SHIM_LIB="$APP/Frameworks/libipakeychain.dylib"
  mkdir -p "$APP/Frameworks"
  catalyst_dylib "$SHIM_LIB" @executable_path/Frameworks/libipakeychain.dylib \
    "$LIB_DIR/ipa-keychain.c" "could not build the keychain shim" \
    -O2 -framework CoreFoundation -framework Security
  link_into_app "$SHIM_LIB" @executable_path/Frameworks/libipakeychain.dylib "the keychain shim"
  KEYCHAIN_NOTE="file-backed shim; items in the container under Library/Application Support/ipa-keychain"
elif [ "$USE_PLAYCHAIN" -eq 1 ]; then
  KEYCHAIN_NOTE="PlayChain, PlayTools' emulated keychain (items in $(tilde "$PLAYCOVER_DIR")/PlayChain/$BID.db)"
else
  KEYCHAIN_NOTE="as shipped (--no-keychain): logins will not survive a relaunch"
fi

# ── OpenGL ES: runtime GL lookups answered by OpenGL ES, as on iOS ─────────
# Every Catalyst process also has desktop OpenGL loaded, first in the global
# search, so dlsym(RTLD_DEFAULT, "gl...") hands an app desktop libGL, which
# crashes at its first call without a CGL context (lib/ipa-gles.c has the
# measurements: Google Photos' editor, EXC_BAD_ACCESS in libGL's
# glCreateShader). Only apps that link OpenGL ES get it.
GLES_NOTE=""
# NUL-separated and captured first: a Mach-O path with a space ("Share
# Extension.appex") or a quote split or stopped a plain xargs, and one failing
# otool then made the whole pipeline false under pipefail.
{ tr '\n' '\0' < "$MACHOS" | xargs -0 "$OTOOL" -L; } > "$WORK/linked" 2>/dev/null || true
if grep -F '/OpenGLES.framework/' "$WORK/linked" >/dev/null; then
  need_lib ipa-gles.c ipa-inject-dylib.py
  need_sdk "install Xcode"
  GLES_LIB="$APP/Frameworks/libipagles.dylib"
  mkdir -p "$APP/Frameworks"
  catalyst_dylib "$GLES_LIB" @executable_path/Frameworks/libipagles.dylib \
    "$LIB_DIR/ipa-gles.c" "could not build the OpenGL ES shim" -O2
  link_into_app "$GLES_LIB" @executable_path/Frameworks/libipagles.dylib "the OpenGL ES shim"
  GLES_NOTE="links OpenGL ES: run-time GL lookups answered by OpenGL ES, not desktop GL (libipagles)"
fi

# ── Extra libraries (--dylib) ─────────────────────────────────────────────
# App-specific code linked into the main executable the same way as the
# shims: a source is built for Mac Catalyst against the macOS SDK (it may use
# Foundation and the Objective-C runtime), a prebuilt dylib is converted like
# every other Mach-O. Linked last, so it loads after the app's own libraries
# and can find their exported symbols with dlsym.
for src in ${DYLIBS[@]+"${DYLIBS[@]}"}; do
  # The library is named after the file, so the name has to be a plain one.
  base=$(basename "$src"); base=${base%.*}
  case "$base" in *[!A-Za-z0-9._-]*) die "--dylib: use a file name of letters, digits, . _ -: $base" ;; esac
  lib="$APP/Frameworks/lib$base.dylib"
  mkdir -p "$APP/Frameworks"
  case "$src" in
    *.dylib)
      cp "$src" "$lib"
      convert_macho "$lib" ;;
    *)
      need_sdk "install Xcode"
      catalyst_dylib "$lib" "@executable_path/Frameworks/lib$base.dylib" "$src" \
        "could not build $(basename "$src")" \
        -O2 -fobjc-arc -framework Foundation -framework CoreFoundation ;;
  esac
  link_into_app "$lib" "@executable_path/Frameworks/lib$base.dylib" "lib$base.dylib"
  DYLIB_NOTE="${DYLIB_NOTE:+$DYLIB_NOTE, }lib$base.dylib"
done

# ── Sign ────────────────────────────────────────────────────────────────────
# PlayCover's base set: sandboxed (so the app gets its own container instead
# of writing into ~/Documents), with the capability entitlements that let a
# sandboxed app ASK for camera, mic, location, contacts, calendars, files.
ENTS="$WORK/entitlements.plist"
cat > "$ENTS" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.device.bluetooth</key><true/>
  <key>com.apple.security.device.usb</key><true/>
  <key>com.apple.security.files.downloads.read-write</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.personal-information.addressbook</key><true/>
  <key>com.apple.security.personal-information.calendars</key><true/>
  <key>com.apple.security.personal-information.location</key><true/>
  <key>com.apple.security.assets.movies.read-write</key><true/>
  <key>com.apple.security.assets.music.read-write</key><true/>
  <key>com.apple.security.assets.pictures.read-write</key><true/>
  <key>com.apple.security.print</key><true/>
</dict></plist>
PLIST
# PlayTools reads its settings, keymaps and PlayChain under PlayCover's
# directory, outside the app's own container, so the app needs a sandbox
# exception for them. PlayCover grants read-write on the WHOLE directory
# (and read on every Group Container, write on .GlobalPreferences); here the
# rules name this app's own files only, because that directory also holds
# every other PlayTools app's plaintext PlayChain, and an ipa is untrusted
# input: settings read-only (only this tool writes them), its keymap
# directory read-write (the in-app editor saves there), its PlayChain
# database and SQLite's journal files beside it. PlayCover's always-on
# denies stay (no fork, no shells: an app probing for /bin/bash or a working
# fork() is looking for a jailbreak).
if [ "$PLAYTOOLS" -eq 1 ]; then
  # plistlib, not `plutil -insert`: plutil reads the dots in the key as a key path.
  python3 - "$ENTS" "$PLAYCOVER_DIR" "$BID" <<'PY' || die "could not add PlayTools' sandbox rules to the entitlements"
import plistlib, sys
ents, pc, bid = sys.argv[1], sys.argv[2], sys.argv[3]
chain = f"{pc}/PlayChain/{bid}.db"
JAILBREAK_PROBES = ("/bin/bash", "/usr/sbin/sshd", "/usr/libexec/ssh-keysign", "/bin/sh",
                    "/etc/ssh/sshd_config", "/usr/libexec/sftp-server", "/usr/bin/ssh")
rules = [
    '(allow user-preference-read (preference-domain ".GlobalPreferences"))',
    f'(allow file-read* (literal "{pc}/App Settings/{bid}.plist"))',
    f'(allow file-read* file-write* (subpath "{pc}/Keymapping/{bid}"))',
]
# The database and the journal files SQLite writes beside it.
rules += [f'(allow file-read* file-write* (literal "{chain}{suffix}"))' for suffix in ("", "-journal", "-wal", "-shm")]
rules += ['(deny process-fork)']
rules += [f'(deny file* file-read* file-read-metadata file-ioctl (literal "{p}"))' for p in JAILBREAK_PROBES]
with open(ents, "rb") as f:
    d = plistlib.load(f)
d["com.apple.security.temporary-exception.sbpl"] = rules
with open(ents, "wb") as f:
    plistlib.dump(d, f)
PY
fi
echo "Signing (ad-hoc, $COUNT Mach-O binaries converted to Mac Catalyst) ..."
# Every Mach-O is signed on its own, as PlayCover does after each conversion:
# `codesign --deep` finds NO nested code in an iOS flat bundle (no Contents/),
# so the frameworks would keep the signature of the bytes vtool had just
# rewritten and the kernel would kill the process at dyld's first page
# (measured 2026-09-06: SIGKILL, CODESIGNING Invalid Page).
while IFS= read -r f; do
  codesign --force --sign - "$f" 2>"$WORK/codesign.err" \
    || die "codesign failed on ${f#"$APP"/}: $(oneline "$WORK/codesign.err")"
done < "$MACHOS"
# Then each nested bundle, inside-out, so their seals match the new binaries.
# A macOS-style bundle (AKInterface) keeps its Info.plist under Contents/.
find "$APP" -depth -mindepth 1 -type d \( -name '*.framework' -o -name '*.appex' -o -name '*.bundle' \) -print0 \
  | while IFS= read -r -d '' b; do
      [ -f "$b/Info.plist" ] || [ -f "$b/Contents/Info.plist" ] || continue
      codesign --force --sign - "$b" 2>/dev/null || true
    done
codesign --force --sign - --entitlements "$ENTS" "$APP" 2>"$WORK/codesign.err" \
  || die "codesign failed: $(oneline "$WORK/codesign.err")"
# Verify every Mach-O the way dyld will, not just the bundle seal.
UNVERIFIED=""
while IFS= read -r f; do
  codesign --verify --strict "$f" 2>/dev/null || UNVERIFIED="$UNVERIFIED  ${f#"$APP"/}"$'\n'
done < "$MACHOS"
if [ "$PLAYTOOLS" -eq 1 ]; then
  codesign --verify --strict "$AK_BUNDLE" 2>/dev/null || UNVERIFIED="$UNVERIFIED  PlugIns/AKInterface.bundle"$'\n'
fi
[ -z "$UNVERIFIED" ] || die "these binaries would be killed at load (signature does not verify):"$'\n'"$UNVERIFIED"
codesign --verify --strict "$APP" 2>"$WORK/verify.err" \
  || die "bundle signature does not verify: $(oneline "$WORK/verify.err")"
xattr -rd com.apple.quarantine "$APP" 2>/dev/null || true

# PlayTools' settings and keymap, written BEFORE the previous copy is moved
# aside: an option the writer refuses (an --aspect the resolution does not
# take) must stop the run while the old install is still in place. Nothing
# here needs the bundle, only its id.
PT_SUMMARY=""
if [ "$PLAYTOOLS" -eq 1 ]; then
  PT_SUMMARY=$(python3 "$LIB_DIR/playtools-config.py" --bundle-id "$BID" \
    --keychain "$([ "$USE_PLAYCHAIN" -eq 1 ] && echo playchain || echo off)" ${PT_ARGS[@]+"${PT_ARGS[@]}"}) \
    || die "could not write PlayTools' settings; nothing was installed"
fi

# ── Install ─────────────────────────────────────────────────────────────────
mkdir -p "$DEST" 2>/dev/null || die "cannot create $DEST"
[ -w "$DEST" ] || die "$DEST is not writable"
TARGET="$DEST/$NAME.app"
if [ -e "$TARGET" ]; then
  # Either shape: what this tool installs keeps the iOS layout, but the target
  # may be an ordinary Mac app someone else put there.
  OLD_BID=$(plutil -extract CFBundleIdentifier raw -o - "$TARGET/Info.plist" 2>/dev/null \
         || plist_get "$TARGET/Contents/Info.plist" CFBundleIdentifier)
  if [ "$OLD_BID" != "$BID" ] && [ "$FORCE" -ne 1 ]; then
    die "$TARGET exists with bundle id ${OLD_BID:-unknown} (not $BID); pass --force to replace it or --dest DIR"
  fi
  TRASH="$HOME/.Trash/$NAME.app.$(date +%Y%m%d_%H%M%S)"
  mkdir -p "$HOME/.Trash"
  if mv "$TARGET" "$TRASH" 2>/dev/null; then
    echo "  previous copy moved to ~/.Trash/$(basename "$TRASH")"
  else
    rm -rf "$TARGET" || die "cannot replace $TARGET"
  fi
fi
# --reset: the container's contents, not the container. Its root belongs to
# containermanagerd and cannot be moved or removed from a shell without Full
# Disk Access. (A running app was already refused, back where NAME became
# known and before the previous copy went to the Trash.)
if [ "$RESET" -eq 1 ]; then
  CONTAINER="$HOME/Library/Containers/$BID/Data"
  if [ -d "$CONTAINER" ]; then
    # Through cfprefsd, so its cached copy of the container-scoped domain goes
    # too: deleting only the plist brought the old values back on relaunch.
    defaults delete "$CONTAINER/Library/Preferences/$BID" >/dev/null 2>&1 || true
    # find -exec, not a glob: an unmatched glob is fatal under zsh's nomatch
    # and shellcheck's SC2115 objects to `rm -rf "$var"/*`.
    find "$CONTAINER" -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} + 2>/dev/null || true
    echo "  reset: container state under ~/Library/Containers/$BID/Data cleared"
  fi
  # PlayChain's store lives beside PlayTools' settings, not in the container.
  # Settings and keymaps are configuration, not state: they stay.
  if [ -e "$PLAYCOVER_DIR/PlayChain/$BID.db" ]; then
    rm -f "$PLAYCOVER_DIR/PlayChain/$BID.db" "$PLAYCOVER_DIR/PlayChain/$BID.db-wal" "$PLAYCOVER_DIR/PlayChain/$BID.db-shm"
    echo "  reset: PlayChain keychain for $BID cleared"
  fi
fi
mv "$APP" "$TARGET" || die "could not move the bundle into $DEST"
[ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$TARGET" >/dev/null 2>&1 || true

# What the scoped sandbox rules cannot create from inside the app: its keymap
# directory (the editor saves there; the rules cover it, not its parent) and
# its PlayChain database. PlayTools' own first connection creates an empty
# database and then returns nil (PlayedAppleDB.connectToDB: `!alreadyCreated
# ||`), so an app's first keychain write would fail with errSecIO; an empty
# file already there is simply given its tables (CREATE TABLE IF NOT EXISTS).
if [ "$PLAYTOOLS" -eq 1 ]; then
  mkdir -p "$PLAYCOVER_DIR/Keymapping/$BID"
  if [ "$USE_PLAYCHAIN" -eq 1 ]; then
    mkdir -p "$PLAYCOVER_DIR/PlayChain"
    [ -e "$PLAYCOVER_DIR/PlayChain/$BID.db" ] || : > "$PLAYCOVER_DIR/PlayChain/$BID.db"
  fi
fi

echo "Installed $TARGET"
echo "  bundle id $BID, signed ad-hoc, sandboxed (container: ~/Library/Containers/$BID)"
if [ "$RESET" -eq 0 ] && [ -d "$HOME/Library/Containers/$BID/Data/Library" ]; then
  echo "  container from an earlier install kept (preferences, caches, keychain store); --reset starts it clean"
fi
echo "  rendering: $RENDER"
echo "  keychain:  $KEYCHAIN_NOTE"
[ -z "$GLES_NOTE" ] || echo "  opengl es: $GLES_NOTE"
[ -z "${DYLIB_NOTE:-}" ] || echo "  linked:    $DYLIB_NOTE (--dylib)"
[ -z "$NEUTRALISED" ] || echo "  neutralised keychain-fix tweak(s):$NEUTRALISED"
if [ "$PLAYTOOLS" -eq 1 ]; then
  echo "  playtools: ${PT_REV:0:7}, embedded; settings in $(tilde "$PLAYCOVER_DIR")"
  printf '%s\n' "$PT_SUMMARY" | sed 's/^/    /'
fi

if [ "$OPEN" -eq 1 ]; then
  echo "Launching ..."
  open "$TARGET" || die "open failed"
  # Launching is not enough: a signature or platform mistake shows up as a
  # process that dies at dyld, so wait for it to be there and stay there.
  i=0
  while [ $i -lt 30 ]; do
    if running_exe "$TARGET/$EXE"; then
      echo "  running: $EXE"
      exit 0
    fi
    sleep 0.5; i=$((i + 1))
  done
  die "the app did not stay running for 15 s; see Console.app > Crash Reports for $EXE"
else
  echo "Launch with: open \"$TARGET\""
fi
